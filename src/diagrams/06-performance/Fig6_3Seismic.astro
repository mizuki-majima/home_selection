---
// 図6-3 耐震等級の3段と実際の被害
import Fact from '../../components/Fact.astro';
import { valueOf } from '../../lib/facts';

const grades = [
  { g: 1, walls: 3, label: '等級1', sub: '建築基準法レベル' },
  { g: 2, walls: 4, label: '等級2', sub: '1.25倍の地震力' },
  { g: 3, walls: 5, label: '等級3', sub: '1.5倍の地震力' },
];
const baseNone = valueOf('kumamoto-2016-grade', 'baseNone');
const baseCollapse = valueOf('kumamoto-2016-grade', 'baseCollapse');
const g3None = valueOf('kumamoto-2016-grade', 'g3None');
const noto = [
  { key: 'g2N', label: '等級2' },
  { key: 'g3N', label: '等級3' },
  { key: 'longlifeN', label: '長期優良' },
];
---

<div class="seis">
  <div class="houses">
    {
      grades.map((h) => (
        <div class="h">
          <svg viewBox="0 0 120 110" role="img" aria-label={`${h.label}（${h.sub}）。壁の線 ${h.walls}本で表現`}>
            <path class="ln" d="M10 50 L60 12 L110 50" />
            <rect x="18" y="50" width="84" height="54" class="ln" />
            {Array.from({ length: h.walls }, (_, i) => {
              const x = 18 + ((i + 1) * 84) / (h.walls + 1);
              return <line class={h.g === 3 ? 'ln-accent' : 'ln'} x1={x} y1="54" x2={x} y2="100" />;
            })}
          </svg>
          <p class="hl">
            <b>{h.label}</b>
            <span>{h.sub}</span>
          </p>
        </div>
      ))
    }
  </div>
  <p class="small">壁の線の本数は強さのイメージです。等級は「その倍率の地震力に対して倒壊・崩壊しない程度」を表します<Fact id="seismic-grades" text="" />。</p>

  <div class="block">
    <p class="bt">熊本地震（2016）・2000年6月以降の木造<Fact id="kumamoto-2016-grade" text="" /></p>
    <div class="band-row">
      <span class="bn">建築基準法レベル<b><Fact id="kumamoto-2016-grade" k="baseN" unit="棟" bare /></b></span>
      <span class="band" aria-hidden="true">
        <span class="none" style={`width:${baseNone}%`}></span>
        <span class="rest"></span>
        <span class="col" style={`width:${Math.max(baseCollapse, 1)}%`}></span>
      </span>
      <span class="bv">無被害 <Fact id="kumamoto-2016-grade" k="baseNone" unit="%" bare />・倒壊 <Fact id="kumamoto-2016-grade" k="baseCollapse" unit="%" bare /></span>
    </div>
    <div class="band-row">
      <span class="bn">耐震等級3<b class="accent"><Fact id="kumamoto-2016-grade" k="g3N" unit="棟" bare /></b></span>
      <span class="band" aria-hidden="true">
        <span class="none accent" style={`width:${g3None}%`}></span>
        <span class="rest"></span>
      </span>
      <span class="bv">無被害 <Fact id="kumamoto-2016-grade" k="g3None" unit="%" bare /></span>
    </div>
    <p class="legend-s"><i class="sw sw-none"></i>無被害　<i class="sw sw-rest"></i>軽微〜大破　<i class="sw sw-col"></i>倒壊</p>
  </div>

  <div class="block">
    <p class="bt">能登半島地震（2024）<Fact id="noto-2024-grade" text="" /></p>
    <div class="dots-grid">
      {
        noto.map((n) => {
          const count = valueOf('noto-2024-grade', n.key);
          return (
            <div>
              <p class="dl">
                {n.label} <b>{count}棟</b>
              </p>
              <div class="dots" role="img" aria-label={`${n.label}の${count}棟のうち1棟が軽微〜中破、ほかは無被害`}>
                {Array.from({ length: count }, (_, i) => (
                  <span class={i === 0 ? 'd hit' : 'd'} />
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
    <p class="small">○ 無被害　<span class="accent">●</span> 軽微〜中破（各1棟）。評価を受けた住宅の実績で、件数は少数です。</p>
  </div>

  <div class="block">
    <p class="bt">地震保険の割引（重複不可）<Fact id="earthquake-insurance" text="" /></p>
    <ul class="ins">
      <li><span>耐震等級1</span><b><Fact id="earthquake-insurance" k="grade1" unit="%" bare /></b></li>
      <li><span>耐震等級2</span><b><Fact id="earthquake-insurance" k="grade2" unit="%" bare /></b></li>
      <li><span>耐震等級3</span><b class="accent"><Fact id="earthquake-insurance" k="grade3" unit="%" bare /></b></li>
      <li><span>免震建築物</span><b><Fact id="earthquake-insurance" k="isolation" unit="%" bare /></b></li>
    </ul>
    <p class="small">割引には、品確法の等級を確認できる資料が必要です。「等級3相当」では受けられない場合があります。</p>
  </div>
</div>

<style>
  .houses {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 520px;
  }

  .h svg {
    width: 100%;
    height: auto;
  }

  .hl {
    margin: 0.3rem 0 0;
    text-align: center;
    line-height: 1.4;
  }

  .hl span {
    display: block;
    font-size: 0.75rem;
    color: var(--mute);
  }

  .small {
    font-size: 0.8rem;
    color: var(--mute);
    margin-top: 0.5rem;
  }

  .block {
    margin-top: 1.8rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--ink);
  }

  .bt {
    font-weight: 800;
    margin: 0 0 0.6rem;
  }

  .band-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.2rem 1rem;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  .bn {
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .bn b {
    display: block;
    font-size: 1.5rem;
  }

  .accent {
    color: var(--accent);
  }

  .band {
    display: flex;
    height: 22px;
    border: 1px solid var(--ink);
  }

  .none {
    background: var(--ink);
  }

  .none.accent {
    background: var(--accent);
  }

  .rest {
    flex: 1;
    background: var(--paper-deep);
  }

  .col {
    background: repeating-linear-gradient(45deg, var(--ink) 0 1px, transparent 1px 4px);
  }

  .bv {
    grid-column: 2;
    font-size: 0.8rem;
    color: var(--mute);
  }

  .legend-s {
    font-size: 0.75rem;
    color: var(--mute);
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .sw {
    display: inline-block;
    width: 14px;
    height: 10px;
    border: 1px solid var(--ink);
  }

  .sw-none {
    background: var(--ink);
  }

  .sw-rest {
    background: var(--paper-deep);
  }

  .sw-col {
    background: repeating-linear-gradient(45deg, var(--ink) 0 1px, transparent 1px 4px);
  }

  .dots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
  }

  .dl {
    margin: 0 0 0.3rem;
    font-size: 0.85rem;
  }

  .dots {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    max-width: 180px;
  }

  .d {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid var(--ink);
  }

  .d.hit {
    background: var(--accent);
    border-color: var(--accent);
  }

  .ins {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 0.5rem 1rem;
  }

  .ins li {
    border-left: 2px solid var(--rule);
    padding-left: 0.6rem;
    font-size: 0.85rem;
  }

  .ins b {
    display: block;
    font-size: 1.4rem;
  }

  @media (max-width: 520px) {
    .band-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .bv {
      grid-column: 1;
    }
  }
</style>
