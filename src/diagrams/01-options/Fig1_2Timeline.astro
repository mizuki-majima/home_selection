---
// 図1-2 家とお金の時間軸（スクロール）。金額と期間は説明のための例。
import Scrolly from '../shared/Scrolly.astro';
import Fact from '../../components/Fact.astro';
import { valueOf } from '../../lib/facts';

// 説明のための例（万円）：土地1,500・建物3,000・自己資金800
const LAND = 1500;
const BUILD = 3000;
const OWN = 800;
const split = {
  contract: valueOf('suumo-payment-split', 'contract'),
  start: valueOf('suumo-payment-split', 'start'),
  framing: valueOf('suumo-payment-split', 'framing'),
  handover: valueOf('suumo-payment-split', 'handover'),
};
const payments = [
  { m: 0, v: LAND * 0.1, label: '土地の手付', step: 1 },
  { m: 1, v: LAND * 0.9, label: '土地の残金', step: 1 },
  { m: 2, v: (BUILD * split.contract) / 100, label: `契約金 約${split.contract}%`, step: 2 },
  { m: 4, v: (BUILD * split.start) / 100, label: `着工金 約${split.start}%`, step: 4 },
  { m: 6, v: (BUILD * split.framing) / 100, label: `上棟金 約${split.framing}%`, step: 4 },
  { m: 10.5, v: (BUILD * split.handover) / 100, label: `残金 約${split.handover}%`, step: 5 },
];
const TOTAL = LAND + BUILD;
const X0 = 34;
const PX = 23; // 1か月あたり
const MONTHS = 15;
const Y_BASE = 262;
const Y_TOP = 96;
const x = (m: number) => X0 + m * PX;
const y = (v: number) => Y_BASE - (v / TOTAL) * (Y_BASE - Y_TOP);

// 累計の階段線を段ごとに分割
let cum = 0;
const segs: { d: string; step: number }[] = [];
payments.forEach((p, i) => {
  const next = payments[i + 1];
  const y0 = y(cum);
  cum += p.v;
  const y1 = y(cum);
  const xEnd = next ? x(next.m) : x(MONTHS - 1);
  segs.push({ d: `M${x(p.m)} ${y0} V${y1} H${xEnd}`, step: p.step === 1 && i === 1 ? 1 : p.step });
});
// 自己資金を超える区間（ローン入金まで）
let c2 = 0;
const pts: string[] = [];
payments.slice(0, 5).forEach((p, i) => {
  c2 += p.v;
  const next = payments[i + 1];
  const top = Math.min(y(c2), y(OWN));
  pts.push(`${x(p.m)},${top}`, `${x(next.m)},${top}`);
});
const shortfall = `M${x(1)},${y(OWN)} L${pts.slice(2).join(' L')} L${x(10.5)},${y(OWN)} Z`;

const events = [
  { m: 0, label: '土地の売買契約', lane: 0, step: 1 },
  { m: 1, label: '土地の決済', lane: 1, step: 1 },
  { m: 2, label: '工事請負契約', lane: 2, step: 2 },
  { m: 3, label: '建築確認', lane: 3, step: 3 },
  { m: 4, label: '着工', lane: 0, step: 4 },
  { m: 6, label: '上棟', lane: 1, step: 4 },
  { m: 9, label: '竣工・完了検査', lane: 0, step: 5 },
  { m: 9.7, label: '適合証明書', lane: 2, step: 5 },
  { m: 10.5, label: '借入契約・資金受取', lane: 3, step: 5 },
];
const laneY = (l: number) => 14 + l * 17;
---

<Scrolly label="注文住宅の段階と支払い時期の時間軸">
  <svg slot="stage" class="tl" viewBox="0 0 400 350" role="img" aria-label="注文住宅では、土地の手付から建物の残金まで支払いが何度もあり、住宅ローンの資金が入るのは竣工後の手続きの後になる。自己資金を超える区間はつなぎ融資などでまかなう。">
    <defs>
      <pattern id="tl-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--accent)" stroke-width="1" />
      </pattern>
    </defs>

    <!-- 月のリボン -->
    <line class="ln" x1={X0} y1="282" x2={x(MONTHS - 1)} y2="282" />
    {
      Array.from({ length: MONTHS }, (_, m) => (
        <g>
          <line class="ln-thin" x1={x(m)} y1="279" x2={x(m)} y2="285" />
          {m % 3 === 0 && (
            <text x={x(m)} y="298" font-size="10" text-anchor="middle" class="mute-text">
              {m}か月
            </text>
          )}
        </g>
      ))
    }
    <text x={X0} y={Y_TOP - 12} font-size="10" class="mute-text">累計の支払い（例）</text>
    <line class="ln-rule" x1={X0} y1={Y_TOP - 4} x2={X0} y2={Y_BASE} />

    <!-- 自己資金の水平線（常に表示） -->
    <line class="ln" x1={X0} y1={y(OWN)} x2={x(MONTHS - 1)} y2={y(OWN)} stroke-dasharray="5 3" />
    <text x={x(MONTHS - 1)} y={y(OWN) + 13} font-size="10.5" text-anchor="end">自己資金</text>

    <!-- 支払いの短冊 -->
    {
      payments.map((p) => (
        <g class="drop" data-step={String(p.step)}>
          <rect x={x(p.m) - 5} y={268} width="10" height="10" class="slip" />
        </g>
      ))
    }

    <!-- 累計の階段線 -->
    {segs.map((s) => <path class="ln draw" data-step={String(s.step)} d={s.d} />)}

    <!-- 自己資金が足りない区間 -->
    <g data-step="4">
      <path d={shortfall} fill="url(#tl-hatch)" opacity="0.9" />
      <text x={x(8)} y={y(OWN) - 12} font-size="10.5" text-anchor="middle" class="accent-text halo">つなぎ融資などが必要な区間</text>
    </g>

    <!-- ローンの入金 -->
    <g data-step="5">
      <path class="ln-accent draw" d={`M${x(10.5)} 320 V${y(TOTAL) + 8}`} />
      <path class="ln-accent" d={`M${x(10.5) - 5} ${y(TOTAL) + 16} L${x(10.5)} ${y(TOTAL) + 6} L${x(10.5) + 5} ${y(TOTAL) + 16}`} />
      <text x={x(10.5) + 6} y="334" font-size="10.5" class="accent-text">住宅ローンの入金はここ</text>
    </g>

    <!-- 段階のラベル -->
    {
      events.map((e) => (
        <g data-step={String(e.step)}>
          <line class="ln-thin" x1={x(e.m)} y1={laneY(e.lane) + 4} x2={x(e.m)} y2="279" stroke-dasharray="1 3" />
          <text x={x(e.m) - 2} y={laneY(e.lane)} font-size="10.5">
            {e.label}
          </text>
        </g>
      ))
    }

    <!-- 建売住宅の流れ -->
    <g data-step="6">
      <line class="ln-thin" x1={x(0)} y1="316" x2={x(2)} y2="316" />
      <circle cx={x(0)} cy="316" r="3" class="dot-ink" />
      <circle cx={x(0.5)} cy="316" r="3" class="dot-ink" />
      <circle cx={x(2)} cy="316" r="3" class="dot-ink" />
      <text x={x(0)} y="336" font-size="10">建売：重説・売買契約→決済・引渡し</text>
    </g>
  </svg>

  <li>
    <h4>土地の契約と手付</h4>
    <p>土地を先に買う場合、売買契約で手付を払い、決済で残金を払います。売主が宅建業者なら、手付は代金の<Fact id="law-takken-39" k="cap" unit="%" />（2割）まで。相手方が契約の履行に着手するまでは、手付を放棄すれば解除できます。</p>
  </li>
  <li>
    <h4>建物の工事請負契約</h4>
    <p>建物は売買ではなく請負契約です。契約時に建物代の約<Fact id="suumo-payment-split" k="contract" unit="%" />を払うのが民間の目安です（実際は契約書による）。</p>
  </li>
  <li>
    <h4>建築確認</h4>
    <p>2階以上か200㎡超の建物は、申請の受理から<Fact id="law-kijunho-review" k="reviewDays" unit="日" />以内に審査されます。</p>
  </li>
  <li>
    <h4>着工・上棟で中間金</h4>
    <p>着工時と上棟時に約30%ずつ。ここで累計の支払いが自己資金を大きく超えます。<strong>斜線の区間</strong>は、つなぎ融資<Fact id="f35-bridge-loan" text="" />などでまかなう部分です。</p>
  </li>
  <li>
    <h4>竣工のあとで、やっとローンが入る</h4>
    <p>工事完了から4日以内に完了検査を申請し、受理から<Fact id="law-kijunho-review" k="inspectDays" unit="日" />以内に検査。フラット35は適合証明書の提出 → 借入れの契約 → 資金の受取りの順で、<strong>金利も資金を受け取る時点で確定</strong>します<Fact id="f35-flow" text="" />。</p>
  </li>
  <li>
    <h4>建売住宅なら</h4>
    <p>現物を見て重要事項説明を受け、売買契約（手付）→ 決済と同時に引渡し。工程の数がまるで違います。</p>
  </li>
</Scrolly>

<p class="tl-note">金額と期間は説明のための例（土地1,500万円・建物3,000万円・自己資金800万円）。支払い割合は民間メディアの目安（二次情報）で、実際は請負契約書によります。</p>

<style>
  .tl {
    width: 100%;
    height: auto;
    max-height: 100%;
    overflow: visible;
  }

  .halo {
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .slip {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1px;
  }

  .tl-note {
    font-size: 0.8rem;
    color: var(--mute);
    margin-top: 1rem;
  }
</style>
