---
// 図4-2 地域で変わるのは土地だった（建設費の左端をそろえた横積み棒）
import Fact from '../../components/Fact.astro';
import { valueOf } from '../../lib/facts';
import { num } from '../../lib/format';

const regions = [
  { key: 'shuto', name: '首都圏' },
  { key: 'kinki', name: '近畿圏' },
  { key: 'tokai', name: '東海圏' },
  { key: 'other', name: 'その他地域' },
];
const MAX = 6500;
const pct = (v: number) => `${((v / MAX) * 100).toFixed(2)}%`;
const SITE_K = 6.2; // √㎡ → px
---

<div class="regions" role="img" aria-label={regions.map((r) => `${r.name}：建設費${num(valueOf('f35-region', `${r.key}Construction`), 1)}万円、土地取得費${num(valueOf('f35-region', `${r.key}Land`), 1)}万円、敷地${valueOf('f35-region', `${r.key}Site`)}㎡、住宅面積${valueOf('f35-region', `${r.key}Area`)}㎡`).join('。')}>
  <div class="legend" aria-hidden="true">
    <span><i class="sw build"></i>建設費</span>
    <span><i class="sw land"></i>土地取得費</span>
    <span><i class="sq"></i>敷地面積（中央値）</span>
    <span><i class="hs"></i>住宅面積</span>
  </div>
  {
    regions.map((r) => {
      const c = valueOf('f35-region', `${r.key}Construction`);
      const l = valueOf('f35-region', `${r.key}Land`);
      const site = valueOf('f35-region', `${r.key}Site`);
      const area = valueOf('f35-region', `${r.key}Area`);
      const side = Math.sqrt(site) * SITE_K;
      const hside = Math.sqrt(area) * SITE_K;
      return (
        <div class="row">
          <p class="name">{r.name}</p>
          <div class="bars" aria-hidden="true">
            <span class="b build" style={`width:${pct(c)}`}>
              <span class="bl">{num(c, 1)}</span>
            </span>
            <span class="b land" style={`width:${pct(l)}`}>
              <span class="bl">{num(l, 1)}</span>
            </span>
          </div>
          <div class="shapes" aria-hidden="true">
            <span class="site" style={`width:${side}px;height:${side}px`}>
              <span class="house" style={`width:${hside * 0.75}px;height:${hside * 0.75}px`} />
            </span>
            <span class="sl">
              敷地 {site}㎡
              <br />
              家 {area}㎡
            </span>
          </div>
        </div>
      );
    })
  }
  <p class="axis" aria-hidden="true">万円（建設費の左端をそろえている）</p>
</div>
<p class="summary">
  建設費は<Fact id="f35-region" k="kinkiConstruction" unit="万円" bare />〜<Fact id="f35-region" k="tokaiConstruction" unit="万円" bare />でほぼ同じなのに、土地取得費は<Fact id="f35-region" k="otherLand" unit="万円" bare />〜<Fact id="f35-region" k="shutoLand" unit="万円" />と約2.5倍開く。所要資金に占める土地の割合は、その他地域 約<Fact id="f35-land-share" k="other" bare />から首都圏 約<Fact id="f35-land-share" k="shuto" />まで。
</p>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    font-size: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sw {
    display: inline-block;
    width: 18px;
    height: 10px;
  }

  .sw.build,
  .b.build {
    background: var(--ink);
  }

  .sw.land,
  .b.land {
    background: repeating-linear-gradient(45deg, var(--accent) 0 1.2px, transparent 1.2px 5px);
    border: 1px solid var(--accent);
  }

  .sq {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 1px dashed var(--ink);
  }

  .hs {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--ink);
  }

  .row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) 11rem;
    gap: 0.5rem 1rem;
    align-items: center;
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
  }

  .name {
    margin: 0;
    font-weight: 700;
  }

  .bars {
    display: flex;
    height: 30px;
  }

  .b {
    position: relative;
    height: 100%;
  }

  .bl {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .b.build .bl {
    left: 6px;
    color: var(--paper);
  }

  .b.land .bl {
    left: 4px;
    background: var(--paper);
    padding: 0 3px;
    color: var(--accent);
    font-weight: 700;
  }

  .shapes {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site {
    display: grid;
    place-items: end start;
    border: 1px dashed var(--ink);
    flex: none;
  }

  .house {
    display: block;
    background: var(--ink);
    margin: 0 0 4px 4px;
  }

  .sl {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--mute);
  }

  .axis {
    font-size: 0.72rem;
    color: var(--mute);
    margin: 0.3rem 0 0 7rem;
  }

  .summary {
    font-size: 0.92rem;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .name {
      grid-column: 1 / -1;
    }
    .axis {
      margin-left: 0;
    }
  }
</style>
