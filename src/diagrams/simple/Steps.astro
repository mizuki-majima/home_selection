---
// やさしい図：家を買うまでの5ステップ
import { chapterHref } from '../../lib/paths';

interface Props {
  /** 各ステップにくわしい章へのリンクを出す */
  links?: boolean;
}
const { links = true } = Astro.props;

const STEPS = [
  {
    t: '考える・調べる',
    d: '住みたい時期・場所・家の種類をざっくり決める',
    ch: '02-types',
    ic: '<circle cx="27" cy="27" r="14"/><line x1="37" y1="37" x2="52" y2="52" class="ac"/><path d="M19 29 L27 21 L35 29 M22 27 V34 H32 V27"/>',
  },
  {
    t: 'お金の計画',
    d: '借りられる額ではなく、返せる額から予算を決める',
    ch: '05-money',
    ic: '<circle cx="32" cy="32" r="20"/><path d="M24 22 L32 32 L40 22 M25 34 H39 M25 40 H39 M32 32 V46" class="ac"/>',
  },
  {
    t: '土地と住宅会社を探す',
    d: '建てられる量と、頼む会社を比べる',
    ch: '06-land',
    ic: '<path d="M32 54 C32 54 48 38 48 26 A16 16 0 0 0 16 26 C16 38 32 54 32 54 Z"/><circle cx="32" cy="26" r="6" class="ac"/>',
  },
  {
    t: '契約',
    d: '間取り・仕様・金額を書類で固めてから',
    ch: '04-builders',
    ic: '<rect x="16" y="10" width="32" height="44" rx="2"/><line x1="23" y1="22" x2="41" y2="22"/><line x1="23" y1="30" x2="41" y2="30"/><path d="M23 44 C27 38 30 48 34 42 S40 44 42 42" class="ac"/>',
  },
  {
    t: '工事・引渡し',
    d: '完成まで何度か支払い、最後にローンが入る',
    ch: '01-timing',
    ic: '<circle cx="22" cy="32" r="10"/><path d="M32 32 H54 M46 32 V40 M52 32 V38" class="ac"/><circle cx="22" cy="32" r="3"/>',
  },
];
---

<ol class="steps">
  {
    STEPS.map((s, i) => (
      <li class="easy-card">
        <span class="no">{i + 1}</span>
        <svg class="ic" viewBox="0 0 64 64" aria-hidden="true" set:html={s.ic} />
        <p class="ttl">{s.t}</p>
        <p>{s.d}</p>
        {links && (
          <a class="more" href={chapterHref(s.ch)}>
            くわしく →
          </a>
        )}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.8rem;
    counter-reset: none;
  }

  .steps li {
    position: relative;
  }

  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -0.8rem;
    top: 50%;
    width: 0.8rem;
    border-top: 1.5px solid var(--accent);
  }

  .no {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .more {
    margin-top: auto;
    font-size: 0.85rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps li {
      display: grid;
      grid-template-columns: 2rem 56px minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 0.8rem;
      align-items: start;
    }

    .steps li:not(:last-child)::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -0.8rem;
      width: 0;
      height: 0.8rem;
      border-top: 0;
      border-left: 1.5px solid var(--accent);
    }

    .no {
      grid-row: 1 / span 3;
      padding-top: 0.4rem;
    }

    .steps .ic {
      grid-row: 1 / span 3;
      width: 56px;
      height: 56px;
    }

    .steps .ttl,
    .steps p,
    .more {
      grid-column: 3;
    }
  }
</style>
