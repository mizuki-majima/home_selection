---
// 図解の外枠。図番号・タイトル・「この図のポイント」・出典番号を統一的に扱う
import { registryOf } from '../lib/sources';
import { LEVEL_LABEL, type Level } from '../data/chapters';

interface Props {
  num: string;
  title: string;
  point: string;
  kind: 'interactive' | 'scroll' | 'static';
  /** 図の難しさ（1 やさしい・2 ふつう・3 くわしい） */
  level: Level;
  facts?: string[];
  id?: string;
}

const { num, title, point, kind, level, facts = [], id } = Astro.props;
const reg = registryOf(Astro.locals);
// 図の中身を先に描画して、中で使われた出典を先に採番する
const body = await Astro.slots.render('default');
const notes = Astro.slots.has('notes') ? await Astro.slots.render('notes') : '';
const numbers = [...new Set(facts.map((f) => reg.register(f).n))].sort((a, b) => a - b);
const kindLabel = { interactive: '触って動く図', scroll: 'スクロールで展開する図', static: '見るだけの図' }[kind];
const figId = id ?? `fig-${num.replace(/[^0-9-]/g, '')}`;
---

<figure class={`fig fig-${kind}`} id={figId} aria-labelledby={`${figId}-title`}>
  <header class="fig-head">
    <span class="fig-num">図{num}</span>
    <h3 id={`${figId}-title`}>{title}</h3>
    <span class="fig-kind">
      <span class={`lv lv-${level}`}>
        <span class="sr-only">難しさ：</span>
        {[1, 2, 3].map((i) => <i class={i <= level ? 'on' : ''} aria-hidden="true" />)}
        {LEVEL_LABEL[level]}の図
      </span>
      {kindLabel}
    </span>
  </header>
  <div class="fig-body"><Fragment set:html={body} /></div>
  <figcaption>
    <p class="point"><span class="point-label">この図のポイント</span>{point}</p>
    {notes && <div class="fig-notes"><Fragment set:html={notes} /></div>}
    {
      numbers.length > 0 && (
        <p class="fig-src">
          出典
          {numbers.map((n) => (
            <a href={`#src-${n}`}>[{n}]</a>
          ))}
        </p>
      )
    }
  </figcaption>
</figure>

<style>
  .fig {
    margin: 4rem 0;
    padding: 0;
  }

  .fig-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0 1rem;
    border-top: 1.5px solid var(--ink);
    padding-top: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .fig-num {
    font-size: 0.85rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .fig-head h3 {
    margin: 0;
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem);
  }

  .fig-kind {
    grid-column: 2;
    font-size: 0.78rem;
    color: var(--mute);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.8rem;
  }

  .lv {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--ink);
    font-weight: 700;
  }

  .lv i {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--accent);
  }

  .lv i.on {
    background: var(--accent);
  }

  .lv i:last-of-type {
    margin-right: 4px;
  }

  figcaption {
    margin-top: 1.25rem;
    font-size: 0.92rem;
  }

  .point {
    margin: 0 0 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--paper-deep);
    border-left: 3px solid var(--accent);
  }

  .point-label {
    display: block;
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .fig-notes {
    color: var(--mute);
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .fig-notes :global(p) {
    margin: 0.3rem 0;
  }

  .fig-src {
    color: var(--mute);
    font-size: 0.82rem;
    margin: 0.4rem 0 0;
  }

  .fig-src a {
    margin-left: 0.3em;
    color: var(--accent);
    text-decoration: none;
  }
</style>
