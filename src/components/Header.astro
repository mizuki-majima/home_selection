---
import { CHAPTERS } from '../data/chapters';
import { chapterHref, withBase } from '../lib/paths';

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={withBase()} aria-label="HOUSE NOTE トップへ">
      <svg viewBox="0 0 28 28" width="24" height="24" aria-hidden="true">
        <path class="ln" d="M3 13 L14 4 L25 13 M6 11 V24 H22 V11" />
        <path class="ln-accent" d="M12 24 V17 H16 V24" />
      </svg>
      <span>HOUSE NOTE</span>
    </a>
    <nav aria-label="章">
      <ol class="chapters">
        {
          CHAPTERS.map((c) => (
            <li>
              <a
                href={chapterHref(c.slug)}
                aria-current={current === c.slug ? 'page' : undefined}
                title={c.title}
              >
                <span class="sr-only">第</span>
                {c.num}
                <span class="sr-only">章 {c.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 0.18em;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .chapters {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .chapters a {
    display: grid;
    place-items: center;
    min-width: 40px;
    min-height: 44px;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }

  .chapters a:hover {
    color: var(--ink);
  }

  .chapters a[aria-current='page'] {
    color: var(--accent);
    font-weight: 800;
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  @media (max-width: 480px) {
    .logo span {
      display: none;
    }
    .chapters a {
      min-width: 38px;
    }
  }
</style>
