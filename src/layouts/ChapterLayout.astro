---
import BaseLayout from './BaseLayout.astro';
import ChapterNav from '../components/ChapterNav.astro';
import SourceList from '../components/SourceList.astro';
import { chapterBySlug } from '../data/chapters';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const chapter = chapterBySlug(slug);
// 要点 → 本文の順に描画して出典を採番し、最後に出典一覧を出す
const points = await Astro.slots.render('points');
const body = await Astro.slots.render('default');
const chars = [...chapter.title];
---

<BaseLayout title={`${chapter.num} ${chapter.title}`} description={chapter.lead} current={slug}>
  <article class="chapter">
    <header class="door wrap">
      <svg class="door-num" viewBox="0 0 320 180" role="img" aria-label={`第${chapter.num}章`}>
        <text x="0" y="160" class="num-outline">{chapter.num}</text>
      </svg>
      <p class="door-kicker">Chapter {chapter.num}</p>
      <h1 class="door-title" aria-label={chapter.title}>
        {
          chars.map((ch, i) => (
            <span aria-hidden="true" style={`--i:${i}`}>
              {ch}
            </span>
          ))
        }
      </h1>
      <p class="door-q">{chapter.question}</p>
      <p class="door-lead measure">{chapter.lead}</p>
    </header>

    <section class="wrap keypoints" aria-labelledby="kp-title">
      <h2 id="kp-title">要点</h2>
      <Fragment set:html={points} />
    </section>

    <div class="wrap body">
      <Fragment set:html={body} />
      <SourceList />
      <ChapterNav slug={slug} />
    </div>
  </article>
</BaseLayout>

<style>
  .door {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: 2rem;
  }

  .door-num {
    width: clamp(160px, 34vw, 300px);
    height: auto;
    display: block;
    margin-left: -6px;
  }

  .num-outline {
    font-family: var(--font-serif);
    font-size: 190px;
    font-weight: 800;
    fill: transparent;
    stroke: var(--accent);
    stroke-width: 1.4px;
    stroke-dasharray: 900;
    stroke-dashoffset: 0;
    animation: draw-num 2.2s var(--ease-out) both;
  }

  @keyframes draw-num {
    from {
      stroke-dashoffset: 900;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .door-kicker {
    letter-spacing: 0.3em;
    font-size: 0.8rem;
    color: var(--mute);
    margin: 0.5rem 0 0.3rem;
    text-transform: uppercase;
  }

  .door-title {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.4rem);
    line-height: 1.3;
    margin: 0 0 1rem;
    overflow: hidden;
  }

  .door-title span {
    display: inline-block;
    animation: rise 0.9s var(--ease-out) both;
    animation-delay: calc(0.35s + var(--i) * 0.045s);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .door-q {
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    font-weight: 700;
    border-left: 3px solid var(--accent);
    padding-left: 0.9rem;
  }

  .door-lead {
    color: var(--mute);
  }

  .keypoints {
    margin-top: 1rem;
  }

  .keypoints h2 {
    font-size: 1rem;
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .keypoints :global(ol) {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: kp;
    max-width: 44em;
  }

  .keypoints :global(ol > li) {
    counter-increment: kp;
    position: relative;
    padding: 1rem 0 1rem 3rem;
    border-top: 1px solid var(--rule);
  }

  .keypoints :global(ol > li::before) {
    content: counter(kp, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.05rem;
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 700;
  }

  .keypoints :global(ol > li strong) {
    display: block;
    font-weight: 800;
  }

  .body :global(h2.sec) {
    margin-top: 5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }

  .body :global(.myths) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .body :global(.myths li) {
    border: 1px solid var(--ink);
    padding: 1rem 1.2rem;
  }

  .body :global(.myth) {
    margin: 0 0 0.6rem;
    color: var(--mute);
    text-decoration: line-through;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
  }

  .body :global(.myth::before) {
    content: '誤解　';
    text-decoration: none;
    display: inline-block;
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
  }

  .body :global(.truth) {
    margin: 0;
  }

  .body :global(.notes) {
    font-size: 0.9rem;
    color: var(--mute);
    padding-left: 1.2rem;
    max-width: 46em;
  }

  .body :global(.prose) {
    max-width: var(--measure);
  }

  @media (prefers-reduced-motion: reduce) {
    .num-outline,
    .door-title span {
      animation: none;
    }
  }
</style>
