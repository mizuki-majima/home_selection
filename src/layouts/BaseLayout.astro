---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { UPDATED } from '../data/chapters';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = '住宅購入（主に新築一戸建て・注文住宅）を検討する人のための図解サイト。土地と建物のトレードオフ、木造と鉄骨、住宅性能、住宅会社の選び方を、図で要点だけ。',
  current,
} = Astro.props;
const fullTitle = title ? `${title}｜HOUSE NOTE` : 'HOUSE NOTE — 家を選ぶ前に、図で読む';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og.png'), Astro.site);
// サイトで使う文字だけに絞ったしっぽり明朝（scripts/subset_fonts.py で生成）。700 は 800 で表示される
const fontCss = [500, 800]
  .map(
    (w) =>
      `@font-face{font-family:'Shippori Mincho';font-style:normal;font-weight:${w};font-display:swap;src:url(${withBase(`fonts/shippori-mincho-${w}.woff2`)}) format('woff2')}`,
  )
  .join('');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preload" href={withBase('fonts/shippori-mincho-500.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta name="theme-color" content="#f4f1ea" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HOUSE NOTE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter fallback="none" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <Header current={current} />
    <main id="main" transition:animate="none">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <Disclaimer />
        <p class="foot-meta">
          <a href={withBase('about/')}>このサイトについて</a>
          <span>更新日 <time datetime={UPDATED}>{UPDATED.replaceAll('-', '.')}</time></span>
          <span>図・イラストはすべて自作</span>
        </p>
      </div>
    </footer>
    <div class="wipe" aria-hidden="true" transition:persist="wipe"></div>
    <script>
      import { setupWipe } from '../diagrams/shared/wipe';
      setupWipe();
    </script>
  </body>
</html>

<style>
  main {
    display: block;
    min-height: 60vh;
  }

  .site-footer {
    margin-top: 6rem;
    padding: 3rem 0 4rem;
    border-top: 1px solid var(--ink);
    font-size: 0.9rem;
  }

  .foot-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--mute);
    margin-top: 1.5rem;
  }

  .wipe {
    position: fixed;
    inset: 0;
    background: var(--accent);
    transform: translateX(-101%);
    pointer-events: none;
    z-index: 200;
  }

  :global(html.wipe-in) .wipe {
    transform: translateX(0);
    transition: transform 0.34s var(--ease-out);
  }

  :global(html.wipe-out) .wipe {
    transform: translateX(101%);
    transition: transform 0.42s var(--ease-out);
  }
</style>
