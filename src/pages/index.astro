---
import BaseLayout from '../layouts/BaseLayout.astro';
import Steps from '../diagrams/simple/Steps.astro';
import { CHAPTERS, STEPS, type Level } from '../data/chapters';
import { chapterHref } from '../lib/paths';

const ICONS: Record<string, string> = {
  '01': 'M6 24 A18 18 0 1 1 42 24 A18 18 0 1 1 6 24 M24 12 V24 L32 30',
  '02': 'M4 40 H44 M6 40 V24 L14 17 L22 24 V40 M26 40 V12 H42 V40 M30 18 H38 M30 26 H38 M30 34 H38',
  '03': 'M8 40 V16 L24 6 L40 16 V40 M8 28 H40 M16 40 V16 M32 40 V16 M8 40 L16 28 M32 28 L40 40',
  '04': 'M12 6 H32 L38 12 V42 H12 Z M18 18 H32 M18 24 H32 M18 30 H28 M30 36 L33 39 L38 33',
  '05': 'M24 6 A18 18 0 1 0 24.01 6 M17 14 L24 23 L31 14 M16 25 H32 M16 31 H32 M24 23 V38',
  '06': 'M6 34 L24 42 L42 34 L24 26 Z M18 29 V20 L24 16 L30 20 V32',
  '07': 'M24 8 V38 M10 38 H38 M8 16 H40 M8 16 L4 28 H14 Z M40 16 L36 28 H46 Z',
  '08': 'M8 40 V18 L24 8 L40 18 V40 Z M14 40 V22 M34 40 V22 M20 26 H28 M24 22 V30',
};
const levels: Level[] = [1, 2, 3];
const title = 'HOUSE NOTE';
---

<BaseLayout>
  <section class="cover wrap">
    <svg class="logo-draw" viewBox="0 0 120 100" aria-hidden="true">
      <path class="ln lg" pathLength="1" d="M10 50 L60 10 L110 50"></path>
      <path class="ln lg" pathLength="1" d="M20 42 V92 H100 V42"></path>
      <path class="ln-accent lg" pathLength="1" d="M52 92 V66 H68 V92"></path>
      <path class="ln lg" pathLength="1" d="M30 58 H44 V72 H30 Z M76 58 H90 V72 H76 Z"></path>
    </svg>
    <h1 class="site-title" aria-label={title}>
      {[...title].map((ch, i) => <span aria-hidden="true" style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
    </h1>
    <p class="catch">家を選ぶ前に、図で読む。</p>
    <p class="intro measure">
      はじめて家を買う人のための図解サイトです。「いつ買う？」「木造と鉄骨はどうちがう？」といったやさしい話から始めて、お金・土地・性能のくわしい話へ、順番に進めるようにしています。数値にはすべて出典と時点を付けています。
    </p>
    <p class="start"><a href={chapterHref(CHAPTERS[0].slug)}>01章から読みはじめる →</a></p>
  </section>

  <section class="wrap toc" aria-labelledby="toc-title">
    <h2 id="toc-title">この順番で読むと、わかりやすい</h2>
    {
      levels.map((lv) => (
        <div class="step-group">
          <p class="step-head">
            <span class="step-label">{STEPS[lv].label}</span>
            <span class="step-title">{STEPS[lv].title}</span>
            <span class="step-note">
              {[1, 2, 3].map((i) => (
                <i class={i <= lv ? 'on' : ''} aria-hidden="true" />
              ))}
              {STEPS[lv].note}
            </span>
          </p>
          <ol>
            {CHAPTERS.filter((c) => c.step === lv).map((c) => (
              <li>
                <a href={chapterHref(c.slug)}>
                  <span class="num">{c.num}</span>
                  <svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
                    <path class="ln" d={ICONS[c.num]} />
                  </svg>
                  <span class="t">
                    <span class="title">{c.title}</span>
                    <span class="q">{c.question}</span>
                  </span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>

  <section class="wrap flow" aria-labelledby="flow-title">
    <h2 id="flow-title">家を買うまでの5ステップ</h2>
    <p class="mute">まずは全体の順番だけつかんでおきましょう。それぞれのステップから、くわしい章へ進めます。</p>
    <Steps />
  </section>
</BaseLayout>

<style>
  .cover {
    padding-top: clamp(3rem, 9vw, 7rem);
    padding-bottom: 1rem;
  }

  .logo-draw {
    width: clamp(90px, 16vw, 140px);
    height: auto;
    display: block;
  }

  .lg {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1.8s var(--ease-out) both;
  }

  .lg:nth-child(2) {
    animation-delay: 0.3s;
  }

  .lg:nth-child(3) {
    animation-delay: 0.7s;
  }

  .lg:nth-child(4) {
    animation-delay: 0.9s;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .site-title {
    font-size: clamp(2.6rem, 1.6rem + 6vw, 5.6rem);
    letter-spacing: 0.12em;
    line-height: 1.1;
    margin: 1.5rem 0 0.8rem;
    overflow: hidden;
  }

  .site-title span {
    display: inline-block;
    animation: rise 0.9s var(--ease-out) both;
    animation-delay: calc(0.6s + var(--i) * 0.05s);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .catch {
    font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem);
    font-weight: 800;
    border-left: 3px solid var(--accent);
    padding-left: 0.9rem;
  }

  .intro {
    color: var(--mute);
  }

  .start a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.4rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-weight: 700;
  }

  .start a:hover {
    background: var(--accent);
    color: var(--paper);
  }

  .toc,
  .flow {
    margin-top: 4rem;
  }

  .toc > h2,
  .flow > h2 {
    font-size: 1rem;
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .step-group {
    margin-top: 1.8rem;
  }

  .step-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.9rem;
    margin: 0 0 0.4rem;
  }

  .step-label {
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .step-title {
    font-weight: 800;
    font-size: 1.15rem;
  }

  .step-note {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.82rem;
    color: var(--mute);
  }

  .step-note i {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--accent);
  }

  .step-note i.on {
    background: var(--accent);
  }

  .step-note i:last-of-type {
    margin-right: 4px;
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1.5px solid var(--ink);
  }

  .toc a {
    display: grid;
    grid-template-columns: 3.2rem 48px minmax(0, 1fr) 2rem;
    gap: 1rem;
    align-items: center;
    padding: 1.1rem 0.4rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background 0.2s;
  }

  .toc a:hover {
    background: var(--paper-deep);
    color: inherit;
  }

  .num {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .icon {
    width: 44px;
    height: 44px;
  }

  .title {
    display: block;
    font-weight: 800;
    font-size: 1.15rem;
  }

  .q {
    display: block;
    color: var(--mute);
    font-size: 0.9rem;
  }

  .arrow {
    color: var(--accent);
    transition: transform 0.2s;
  }

  .toc a:hover .arrow {
    transform: translateX(4px);
  }

  .flow > p {
    font-size: 0.92rem;
  }

  @media (max-width: 520px) {
    .toc a {
      grid-template-columns: 2.4rem minmax(0, 1fr) 1.2rem;
    }
    .icon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lg,
    .site-title span {
      animation: none;
    }
  }
</style>
