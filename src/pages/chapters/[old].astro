---
// 公開初日の旧URL（章の並べ替え前）から、新しい章へ案内する
import { OLD_SLUGS, chapterBySlug } from '../../data/chapters';
import { chapterHref } from '../../lib/paths';

export function getStaticPaths() {
  return Object.entries(OLD_SLUGS).map(([old, next]) => ({ params: { old }, props: { next } }));
}

const { next } = Astro.props;
const chapter = chapterBySlug(next);
const href = chapterHref(next);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <link rel="canonical" href={new URL(href, Astro.site)} />
    <title>移動しました｜HOUSE NOTE</title>
  </head>
  <body style="background:#f4f1ea;color:#1a1a1a;font-family:serif;padding:2rem">
    <p>このページは「<a href={href}>{chapter.num} {chapter.title}</a>」に移動しました。</p>
  </body>
</html>
